turbostream() {
    if [ $# -eq 0 ]; then
        cat <<'EOF'
Usage: turbostream inputfile outputfile ngpu_per_host

Arguments:
  inputfile       Path to input HDF5 file
  outputfile      Path to output HDF5 file
  ngpu_per_host   Number of GPUs per host

EOF
        return 0
    fi

    if [ $# -ne 3 ]; then
        echo "Error: expected 3 arguments, got $#" >&2
        return 1
    fi

    echo "Dummy TS3 run: $1 -> $2 (ngpu_per_host=$3)"
    return 0
}

mpirun() {
    # Strip mpirun flags and find the turbostream call
    while [ $# -gt 0 ]; do
        case "$1" in
            -npernode|-np|-n) shift 2 ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    "$@"
}
