{
  "title": "turbigen",
  "metaDataConfig": {
    "metaDataUrl": "turbines/metaData.json",
    "metaDataCsv": false,
    "generateTaskIds": false,
    "taskIdRoot": "case_",
    "taskIdFormat": "d",
    "setLabelsToTaskIds": false
  },
  "uiConfig": {
    "plotTasksButton": true,
    "saveTasksButton": false,
    "replaceTasksNameWith" : "Cases"
  },
  "plotRows": [
    {
      "title": "3D box database",
      "plots": [
        {
          "plotType": "cfD3Histogram",
          "data": {
            "property": "eta_tt"
          },
          "layout": {
            "title": "Efficiency",
            "colWidth": 3,
            "height": 300,
            "highlightTasks": true
          }
        }
      ]
    },
    {
      "title" : "3-D Surface plots",
      "plots" : [] ,
      "ctrl" : {
	"plotType" : "threeTriMesh" ,
	"fetchData" : {
	  "urlTemplate" : "turbines/${taskId}/cut_1.tm3" ,
	  "buffer" : true ,
	  "tasksByFilter" : true ,
	  "maxTasks" : 8
	},
	"layout" : {
	  "colWidth" : 3 ,
	  "height" : 350
	}
      }
    }
  ]
}
